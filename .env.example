# Local development only. On AWS these come from /etc/thyme/api.env (non-secret) and
# Secrets Manager (username/password) - see deploy/. Never commit a real .env.
NODE_ENV=development
RDS_HOSTNAME=localhost
RDS_USERNAME=thyme
RDS_PASSWORD=thyme-local-password
RDS_DB_NAME=thyme
RDS_PORT=5432
RDS_SSL=false
