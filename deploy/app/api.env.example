# /etc/thyme/api.env on the APP-tier server (mode 640, owner root:thyme).
# NON-secret settings only. The database username and password come from AWS Secrets Manager
# (fetch-secrets.sh writes them to /run/thyme/db.env at start-up, in memory only).
NODE_ENV=production
PORT=3001

# RDS endpoint: RDS console -> your DB -> Connectivity & security -> Endpoint
RDS_HOSTNAME=thyme-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=thyme
RDS_SSL=true

# Secrets Manager secret holding {"username": "...", "password": "..."}
SECRET_ID=thyme/db-credentials
AWS_REGION=us-east-1

# Proxies between the browser and this process, so rate limiting sees the real client IP.
# Public ALB -> nginx on web tier -> internal ALB -> this server = 3.
# Check: an http_request log line must show your own public IP in "ip", not a 10.x address.
TRUST_PROXY_HOPS=3

# Secure cookie flag. true once the site is served over HTTPS (ACM certificate on the ALB).
# If the site is still plain HTTP, browsers drop Secure cookies and sign-in silently fails:
# set false for now and say so in your presentation.
COOKIE_SECURE=true

LOG_LEVEL=info
