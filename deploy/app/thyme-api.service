# /etc/systemd/system/thyme-api.service
[Unit]
Description=Thyme API (Express + PostgreSQL)
After=network-online.target
Wants=network-online.target

[Service]
User=thyme
Group=thyme
WorkingDirectory=/opt/thyme/backend
RuntimeDirectory=thyme
RuntimeDirectoryMode=0700

# Non-secret config, then the DB credentials that fetch-secrets.sh writes just before start.
EnvironmentFile=/etc/thyme/api.env
EnvironmentFile=-/run/thyme/db.env
ExecStartPre=+/opt/thyme/deploy/app/fetch-secrets.sh
ExecStart=/opt/thyme/backend/node_modules/.bin/tsx server/index.ts

# One JSON log line per event -> this file -> CloudWatch agent -> CloudWatch Logs.
UMask=0022
StandardOutput=append:/var/log/thyme/api.log
StandardError=append:/var/log/thyme/api.log

Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/log/thyme

[Install]
WantedBy=multi-user.target
